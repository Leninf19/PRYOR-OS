{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/data.js": {
      "includeFiles": "private-data/**"
    },
    "api/actions/[action].js": {
      "includeFiles": "private-data/location-contacts.json"
    }
  },
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }]
}
