{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "git": {
    "deploymentEnabled": false
  },
  "functions": {
    "api/data.js": {
      "includeFiles": "private-data/**"
    },
    "api/actions/[action].js": {
      "includeFiles": "private-data/{location-contacts.json,meta.json,_internal/review-location-index.json}"
    },
    "api/settings/[action].js": {
      "includeFiles": "private-data/{location-contacts.json,meta.json}"
    },
    "api/google/[action].js": {
      "includeFiles": "private-data/_internal/{review-location-index.json,gbp-location-link-map.json}"
    },
    "api/notifications/[action].js": {
      "includeFiles": "private-data/{meta.json,_internal/review-location-index.json,reviews/by-location/*.json}"
    },
    "api/tasks/[action].js": {
      "includeFiles": "private-data/{meta.json,_internal/review-location-index.json,reviews/by-location/*.json}"
    }
  },
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }]
}
