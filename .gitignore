# Google Takeout exports (large, local only)
takeout-*/
account-*/
*.zip
Google Business Profile/

# Python
__pycache__/
*.pyc
*.pyo
scraped_reviews.csv
scraped_missing.csv
gbp_import_report.json

# Local input file for set_location_contacts.py --from-csv -- real contact
# emails belong in dashboard/reviews.db (already committed, same as every
# other location field), never as a loose plaintext scratch file in git.
location_contacts.csv

# Node
node_modules/
dashboard/node_modules/
dashboard/dist/

# Vercel auth (keep project.json for CI deployment)
dashboard/.vercel/auth.json
dashboard/.vercel/cache/

# Credentials
credentials.json
token.json
*.env

# auto_update.py --local's mutation lock (see local_safety.py) -- must
# never be committed; it's meaningful only on the machine that created it.
.local_db_mutation.lock

# MockProvider's local snapshot (see bootstrap_mock_snapshot.py/provider_mock.py)
# -- a point-in-time copy of dashboard/reviews.db for local dev only, never
# committed; it's meaningful only on the machine that created it.
dashboard/reviews.snapshot.db
